<section id="explorar" class="py-20 px-6 bg-neutral-900 text-white text-center">
    <h3 class="text-3xl font-bold mb-4">Accede al Atlas Virtual</h3>
    <p class="mb-12 md:mb-6 max-w-xl mx-auto">
        Navega por las distintas secciones anatómicas, explora imágenes en
        alta resolución y aprende sobre la salud y enfermedad de la
        zarigüeya.
    </p>
    <a
        id="atlas-link"
        href="/atlas/es"
        class="bg-white text-neutral-900 font-semibold px-6 py-3 rounded-full hover:bg-orange-100 transition"
    >
        Ir al Atlas
    </a>
</section>

<script>
    const atlasLink = document.getElementById("atlas-link") as HTMLAnchorElement;
    
    // Detect browser language
    const browserLang = navigator.language;
    const langCode = browserLang.startsWith("es") ? "es" : "en";
    
    // Check for saved preference
    const savedLang = localStorage.getItem("atlas-lang");
    const targetLang = savedLang || langCode;
    
    // Update href
    if (atlasLink) {
        atlasLink.href = `/atlas/${targetLang}`;
    }
</script>