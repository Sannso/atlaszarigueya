---
// People.astro - Componente para mostrar el equipo del proyecto
---

<section id="equipo" class="people-section py-16 px-4 bg-cover bg-center bg-no-repeat relative">
  <div class="absolute inset-0 bg-[url('/images/atlas/general/bgPeople.jpg')] bg-cover bg-center bg-no-repeat top-3" style="filter: blur(7px);"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-[#F0F8E8] via-[#F8FCF4]/70 to-transparent z-10"></div>
  <div class="max-w-6xl mx-auto relative z-40">
    
    <!-- Título de la sección -->
    <h2 class="text-4xl font-bold text-center mb-4 text-gray-800">Nuestro Equipo</h2>
    <p class="text-center text-gray-600 mb-12 max-w-3xl mx-auto">
      Conoce a las personas que hacen posible este proyecto de investigación
    </p>

    <!-- Investigadoras (Estudiantes) -->
    <div class="mb-16 px-10">
      <h3 class="text-2xl font-semibold font-montserrat-medium mb-8 text-center text-gray-700">Investigadoras</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Investigadora 1 -->
        <div class="person-card bg-blue-50 rounded-lg shadow-md p-6 text-center">
          <div class="w-32 h-32 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/yiseell.webp" alt="Yiseell Tatiana Ossa Campos" class="w-full h-full object-cover object-top" style="object-position: 50% 15%;" />
          </div>
          <h4 class="text-xl font-semibold mb-2">Yiseell Tatiana Ossa Campos</h4>
          <p class="text-gray-600 mb-3">Estudiante de Medicina Veterinaria y Zootecnia</p>
          <p class="text-sm text-gray-500">Universidad Tecnologica de Pereira</p>
          <p class="text-sm text-gray-500">yiseell.ossa@utp.edu.co</p>
        </div>

        <!-- Investigadora 2 -->
        <div class="person-card bg-blue-50 rounded-lg shadow-md p-6 text-center">
          <div class="w-32 h-32 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/gabriela.webp" alt="Diana Gabriela Villamil Alzate" class="w-full h-full object-cover" />
          </div>
          <h4 class="text-xl font-semibold mb-2">Diana Gabriela Villamil Alzate</h4>
          <p class="text-gray-600 mb-3">Estudiante de Medicina Veterinaria y Zootecnia</p>
          <p class="text-sm text-gray-500">Universidad Tecnologica de Pereira</p>
          <p class="text-sm text-gray-500">gabriela.villamil@utp.edu.co</p>
        </div>

        <!-- Investigadora 3 -->
        <div class="person-card bg-blue-50 rounded-lg shadow-md p-6 text-center">
          <div class="w-32 h-32 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/lisenia.webp" alt="Diana Lisenia Martínez Gómez" class="w-full h-full object-cover" />
          </div>
          <h4 class="text-xl font-semibold mb-2">Diana Lisenia Martínez Gómez</h4>
          <p class="text-gray-600 mb-3">Estudiante de Medicina Veterinaria y Zootecnia</p>
          <p class="text-sm text-gray-500">Universidad Tecnologica de Pereira</p>
          <p class="text-sm text-gray-500">diana.martinez1@utp.edu.co</p>
        </div>
      </div>
    </div>

    <!-- Docentes Guía -->
    <div class="mb-16 px-10">
      <h3 class="text-2xl font-semibold font-montserrat-medium mb-8 text-center text-gray-700">Docentes Guía</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        
        <!-- Docente 1 -->
        <div class="person-card bg-gray-200 rounded-lg shadow-md p-6 text-center">
          <div class="w-32 h-32 mx-auto mb-4 bg-gray-300 rounded-full flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/carolina.webp" alt="Carolina Mejía Bermonth" class="w-full h-full object-cover" />
          </div>
          <h4 class="text-xl font-semibold mb-2">Carolina Mejía Bermonth</h4>
          <p class="text-gray-600 mb-3">Docente Asesora</p>
          <p class="text-sm text-gray-500">Universidad Tecnologica de Pereira</p>
          <p class="text-sm text-gray-500">carolina.mejia@utp.edu.co</p>
        </div>

        <!-- Docente 2 -->
        <div class="person-card bg-gray-200 rounded-lg shadow-md p-6 text-center">
          <div class="w-32 h-32 mx-auto mb-4 bg-gray-300 rounded-full flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/margarita.webp" alt="Margarita Maria Mazo Cardona" class="w-full h-full object-cover object-top" style="object-position: 50% 30%;" />
          </div>
          <h4 class="text-xl font-semibold mb-2">Margarita Maria Mazo Cardona</h4>
          <p class="text-gray-600 mb-3">Docente Asesora</p>
          <p class="text-sm text-gray-500">Corporación Universitaria Santa Rosa de Cabal</p>
          <p class="text-sm text-gray-500">margarita.mazo@unisarc.edu.co</p>
        </div>
      </div>
    </div>

    <!-- Instituciones Participantes -->
    <div class="mb-16">
      <h3 class="text-2xl font-semibold font-montserrat-medium mb-8 text-center text-gray-700">Instituciones Participantes</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        
        <!-- UTP -->
        <div class="institution-card bg-white rounded-lg shadow-md p-8 text-center">
          <div class="w-32 h-20 mx-auto mb-4 bg-white rounded-lg flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/institucion_utp.webp" alt="Universidad Tecnologica de Pereira" class="w-full h-full object-contain" />
          </div>
          <h4 class="text-lg font-semibold mb-2">UTP</h4>
          <p class="text-sm text-gray-600">Universidad Tecnológica de Pereira</p>
        </div>

        <!-- Vicerrectoría -->
        <div class="institution-card bg-white rounded-lg shadow-md p-8 text-center">
          <div class="w-full h-16 mx-auto mb-4 bg-white rounded-lg flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/institucion_vicerectoria.webp" alt="Vicerrectoría" class="w-full h-full object-contain" />
          </div>
          <h4 class="text-lg font-semibold mb-2">Vicerrectoría</h4>
          <p class="text-sm text-gray-600">Vicerrectoría de Investigaciones, Innovación y Extensión</p>
        </div>

        <!-- MVZ -->
        <div class="institution-card bg-white rounded-lg shadow-md p-8 text-center">
          <div class="w-24 h-24 mx-auto mb-4 bg-white rounded-lg flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/institucion_mvz.webp" alt="MVZ" class="w-full h-full object-contain" />
          </div>
          <h4 class="text-lg font-semibold mb-2">Programa</h4>
          <p class="text-sm text-gray-600">Medicina Veterinaria y Zootecnia</p>
        </div>

        <!-- CARDER -->
        <div class="institution-card bg-white rounded-lg shadow-md p-8 text-center">
          <div class="w-24 h-24 mx-auto mb-4 bg-white rounded-lg flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/institucion_carder.webp" alt="CARDER" class="w-full h-full object-contain" />
          </div>
          <h4 class="text-lg font-semibold mb-2">CARDER</h4>
          <p class="text-sm text-gray-600">Corporación Autónoma Regional de Risaralda</p>
        </div>

        <!-- UNISARC -->
        <div class="institution-card bg-white rounded-lg shadow-md p-8 text-center">
          <div class="w-24 h-24 mx-auto mb-4 bg-white rounded-lg flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/institucion_unisarc.webp" alt="UNISARC" class="w-full h-full object-contain" />
          </div>
          <h4 class="text-lg font-semibold mb-2">UNISARC</h4>
          <p class="text-sm text-gray-600">Corporación Universitaria Santa Rosa de Cabal</p>
        </div>

        <!-- Salud -->
        <div class="institution-card bg-white rounded-lg shadow-md p-8 text-center">
          <div class="w-24 h-24 mx-auto mb-4 bg-white rounded-lg flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/institucion_salud.webp" alt="Secretaría de Salud" class="w-full h-full object-contain" />
          </div>
          <h4 class="text-lg font-semibold mb-2">Facultad</h4>
          <p class="text-sm text-gray-600">Ciencias de la Salud</p>
        </div>

        <!-- Semillero -->
        <div class="institution-card bg-white rounded-lg shadow-md p-8 text-center">
          <div class="w-24 h-24 mx-auto mb-4 bg-white rounded-lg flex items-center justify-center overflow-hidden">
            <img src="/images/people_logos/institucion_semillero.webp" alt="Semillero" class="w-full h-full object-contain" />
          </div>
          <h4 class="text-lg font-semibold mb-2">Semillero de Investigación</h4>
          <p class="text-sm text-gray-600">APATVET</p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .person-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .person-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .institution-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .institution-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
</style>