---
import AtlasLayout from "@layouts/AtlasLayout.astro";
import { getCollection } from 'astro:content';


export async function getStaticPaths() {
  const all = await getCollection('atlas');

  return all.map((entry) => {
    const parts = entry.slug.split('/'); // e.g., ['es','anatomia','intro']
    const lang = parts[0];
    // For a rest parameter, slug must be an array of segments
    return { params: { lang, slug: parts.slice(1).join('/') }, props: { entry } };
  });
}


const { entry } = Astro.props;
const { Content } = await entry.render();

---

<AtlasLayout currentPath={Astro.url.pathname} lang={entry?.data.lang as 'es' | 'en'}>
  <section class={`flex w-full flex-col gap-4 mx-4 md:mx-12 py-6
                   [&>h1]:text-3xl [&>h1]:font-bold
                   [&>h2]:text-2xl [&>h2]:font-bold
                  `}>
    <h1 class="text-center">{entry?.data.title}</h1>
    <Content />
  </section>
</AtlasLayout>
