---
import Layout from "@layouts/Layout.astro";
import AtlasSidebar from "@components/AtlasSidebar.astro";
import AtlasHeader from "@components/AtlasHeader.astro";

interface Props {
  lang: "es" | "en";
  currentPath: string;
}

const { lang, currentPath } = Astro.props as Props;
---

<Layout>
  <AtlasHeader />
  <section class="flex min-h-screen font-archivo text-black dark:bg-neutral-900 dark:text-orange-100">
    <aside class="min-h-screen w-64 shrink-0 hidden md:block text-black dark:bg-neutral-800 dark:text-orange-100 px-4 md:px-6 py-6">
      <AtlasSidebar lang={lang} currentPath={currentPath} />
    </aside>
    <slot />
  </section>
</Layout>
