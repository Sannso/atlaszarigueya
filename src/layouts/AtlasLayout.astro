---
import Layout from "@layouts/Layout.astro";
import AtlasSidebar from "@components/AtlasSidebar.astro";
import AtlasHeader from "@components/AtlasHeader.astro";

interface Props {
  lang: "es" | "en";
  currentPath: string;
}

const { lang, currentPath } = Astro.props as Props;
---

<Layout>
  <AtlasHeader />
  <section class="flex min-h-screen font-archivo text-black dark:bg-neutral-900 dark:text-orange-100">
    <!-- Mobile sidebar overlay -->
    <div id="sidebar-overlay" class="hidden fixed inset-0 bg-black/50 z-40 md:hidden"></div>
    
    <!-- Mobile sidebar -->
    <aside id="mobile-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 min-h-screen shrink-0 -translate-x-full transition-transform duration-300 ease-in-out md:hidden text-black bg-white/90 dark:bg-neutral-800/90 dark:text-orange-100 backdrop-blur-md">
      <AtlasSidebar lang={lang} currentPath={currentPath} />
    </aside>
    
    <!-- Desktop sidebar -->
    <aside class="min-h-screen w-64 shrink-0 hidden md:block text-black dark:bg-neutral-800 dark:text-orange-100">
      <AtlasSidebar lang={lang} currentPath={currentPath} />
    </aside>
    <slot />
  </section>
</Layout>